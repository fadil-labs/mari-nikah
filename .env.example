# ==========================================
# App Configuration
# ==========================================

# Base URL aplikasi (digunakan untuk link undangan, callback, dan redirect)
NEXT_PUBLIC_BASE_URL=http://localhost:3020

# Secret key untuk autentikasi cron job endpoint
CRON_SECRET_KEY=your_cron_secret_here

# ==========================================
# Supabase Configuration
# ==========================================

# URL project Supabase (public, dapat diakses dari client)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url

# Anon/public key Supabase (public, digunakan untuk client-side operations)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key Supabase (RAHASIA, hanya untuk server-side operations)
# Berisi hak penuh, JANGAN EVER expose ke client
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ==========================================
# Midtrans Payment Gateway Configuration
# ==========================================

# Server key Midtrans untuk autentikasi API (RAHASIA, hanya server-side)
MIDTRANS_SERVER_KEY=your_midtrans_server_key

# Client key Midtrans (public, digunakan untuk client-side Snap JS)
MIDTRANS_CLIENT_KEY=your_midtrans_client_key

# Toggle environment Midtrans: true untuk production, false untuk sandbox
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ==========================================
# WhatsApp Gateway Configuration
# ==========================================

# URL endpoint REST API WhatsApp Gateway (Fonnte / Wablas / Baileys Service)
# Contoh Fonnte: https://api.fonnte.com/send-message
# Contoh Wablas: https://wablas.com/api/send-message
WA_GATEWAY_URL=your_wa_gateway_endpoint

# Token/Bearer untuk autentikasi WhatsApp Gateway
WA_GATEWAY_TOKEN=your_wa_gateway_token
